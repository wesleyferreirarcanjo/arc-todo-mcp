PORT=8000
ARC_TODO_API_BASE_URL=http://localhost:3000
# Service account: used ONLY at startup to fetch enabled MCP tool keys.
# Tenant tool calls use each Cursor user's own JWT from mcp.json headers:
#   "headers": { "Authorization": "Bearer <user-jwt>" }
ARC_TODO_USERNAME=admin
ARC_TODO_PASSWORD=admin123
# Optional: use a pre-issued token instead of username/password
# ARC_TODO_ACCESS_TOKEN=
# arc-hub admin tools (hub_* group) call the hub directly with this bearer.
# Leave unset to disable them; the token never appears in tool arguments.
# ARC_HUB_BASE_URL=http://localhost:18090
# ARC_HUB_TOKEN=
MCP_TOOL_SETTINGS_REFRESH_ON_START=true
